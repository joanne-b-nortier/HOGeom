Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Numerically", " ", "solve", " ", "mu", " ", "if", " ", "beta", " ", "is", 
    " ", "within", " ", "delta_", " ", "distance", " ", "of", " ", "1"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "muSolve", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"muSolve", "[", 
     RowBox[{
      RowBox[{"beta_", "?", "NumericQ"}], ",", 
      RowBox[{"N_", "?", "NumericQ"}], ",", 
      RowBox[{"lambdaI_", "?", "NumericQ"}], ",", 
      RowBox[{"kapI_", "?", "NumericQ"}], ",", 
      RowBox[{"meank_", "?", "NumericQ"}], ",", 
      RowBox[{"delta_", ":", "5"}]}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"mu", ",", "eqn", ",", "sol", ",", "betaEff"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"--", 
          RowBox[{"-", "case"}]}], " ", "1"}], ":", " ", 
        RowBox[{"|", 
         RowBox[{"beta", "-", "1"}], "|", " ", 
         RowBox[{
          RowBox[{"<", "delta"}], "\[RightArrow]", 
          RowBox[{
           RowBox[{"implicit", " ", 
            RowBox[{"equation", "--"}]}], "-"}]}]}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"beta", "-", "1"}], "]"}], "<", "delta"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"betaEff", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"1", ",", "beta"}], "]"}]}], ";", 
          RowBox[{"(*", 
           RowBox[{"your", " ", "max", 
            RowBox[{"(", 
             RowBox[{"1", ",", "beta"}], ")"}], " ", "rule"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"eqn", "=", 
           RowBox[{"kapI", "==", 
            RowBox[{"N", "*", 
             RowBox[{"Hypergeometric2F1", "[", 
              RowBox[{"1", ",", 
               RowBox[{"1", "/", "beta"}], ",", 
               RowBox[{"1", "+", 
                RowBox[{"1", "/", "beta"}]}], ",", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"N", "/", "2"}], ")"}], "^", "beta"}]}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"mu", "*", "lambdaI", "*", "kapI"}], ")"}], "^", 
                  "betaEff"}], ")"}]}]}], "]"}]}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"sol", "=", 
           RowBox[{"Quiet", "@", 
            RowBox[{"FindRoot", "[", 
             RowBox[{"eqn", ",", 
              RowBox[{"{", 
               RowBox[{"mu", ",", 
                RowBox[{"1", "/", "10"}]}], "}"}], ",", 
              RowBox[{"(*", 
               RowBox[{"reasonable", " ", "initial", " ", "guess"}], "*)"}], 
              RowBox[{"WorkingPrecision", "->", "40"}], ",", 
              RowBox[{"AccuracyGoal", "->", "15"}], ",", 
              RowBox[{"PrecisionGoal", "->", "15"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{"Re", "[", "mu", "]"}], "/.", " ", "sol"}], "]"}], 
          ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", "case"}]}], " ", "2"}], ":", 
         RowBox[{
          RowBox[{"beta", ">", "1"}], "\[RightArrow]", 
          RowBox[{
           RowBox[{"analytic", " ", 
            RowBox[{"formula", "--"}]}], "-"}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"beta", ">", "1"}], ",", 
         RowBox[{
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"beta", "*", 
              RowBox[{"Sin", "[", 
               RowBox[{"Pi", "/", "beta"}], "]"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "Pi", " ", "meank"}], ")"}]}], "]"}], ";"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"--", 
           RowBox[{"-", "case"}]}], " ", "3"}], ":", 
         RowBox[{
          RowBox[{"beta", "<", "1"}], "\[RightArrow]", 
          RowBox[{
           RowBox[{"analytic", " ", 
            RowBox[{"formula", "--"}]}], "-"}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"beta", "<", "1"}], ",", 
         RowBox[{
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", "beta"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2", "^", "beta"}], ")"}]}], "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"N", "^", 
               RowBox[{"(", 
                RowBox[{"beta", "-", "1"}], ")"}]}], ")"}], "/", "meank"}]}], 
           "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"fallback", " ", 
         RowBox[{"(", 
          RowBox[{"should", " ", "never", " ", "be", " ", "reached"}], 
          ")"}]}], "*)"}], 
       RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}]}], 
   "\n"}]}]], "Input",
